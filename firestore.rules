rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'modelatech2026@gmail.com' ||
        request.auth.token.email.lower() == 'sushoovandas@gmail.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-@.]+$');
    }

    function isValidAccessRequest(data) {
      return (('fullName' in data && data.fullName is string) || ('name' in data && data.name is string))
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && (data.status in ['pending', 'Pending', 'approved', 'Approved', 'rejected', 'Rejected', 'APPROVED', 'REJECTED']);
    }

    // Access Requests Collection
    match /access_requests/{requestId} {
      allow read: if true;

      allow create: if isValidAccessRequest(incoming());

      allow update: if true;

      allow delete: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Projects Collection
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Project Assignments Collection
    match /project_assignments/{assignmentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Disciplines Collection
    match /disciplines/{disciplineId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Project Feedbacks Collection
    match /project_feedbacks/{feedbackId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Daily Work Logs Collection
    match /work_logs/{logId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /daily_logs/{logId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
