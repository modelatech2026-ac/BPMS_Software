rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'modelatech2026@gmail.com' ||
        request.auth.token.email.lower() == 'sushoovandas@gmail.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-@.]+$');
    }

    function isValidAccessRequest(data) {
      return (('fullName' in data && data.fullName is string) || ('name' in data && data.name is string) || ('email' in data && data.email is string))
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200;
    }

    // Access Requests Collection
    match /access_requests/{requestId} {
      allow read: if true;

      allow create: if isValidAccessRequest(incoming());

      allow update: if true;

      allow delete: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Projects Collection
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Project Assignments Collection
    match /project_assignments/{assignmentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Disciplines Collection
    match /disciplines/{disciplineId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Project Feedbacks Collection
    match /project_feedbacks/{feedbackId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    function isSuperAdmin() {
      return isAdmin() || (
        isSignedIn() && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DIRECTOR')) ||
          (exists(/databases/$(database)/documents/access_requests/$(request.auth.uid)) &&
           (get(/databases/$(database)/documents/access_requests/$(request.auth.uid)).data.assignedRole == 'SUPER_ADMIN' ||
            get(/databases/$(database)/documents/access_requests/$(request.auth.uid)).data.assignedRole == 'DIRECTOR' ||
            get(/databases/$(database)/documents/access_requests/$(request.auth.uid)).data.role == 'Super Admin' ||
            get(/databases/$(database)/documents/access_requests/$(request.auth.uid)).data.role == 'Director'))
        )
      );
    }

    function isLogOwner(data) {
      return isSignedIn() && (
        ('memberEmail' in data && data.memberEmail is string && request.auth.token.email != null && data.memberEmail.lower() == request.auth.token.email.lower()) ||
        ('userEmail' in data && data.userEmail is string && request.auth.token.email != null && data.userEmail.lower() == request.auth.token.email.lower()) ||
        ('userId' in data && data.userId is string && data.userId == request.auth.uid) ||
        ('employeeId' in data && data.employeeId is string && data.employeeId == request.auth.uid)
      );
    }

    // Daily Work Logs Collection
    match /work_logs/{logId} {
      allow read: if isSuperAdmin() || isLogOwner(resource.data);
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        ('memberEmail' in incoming() && incoming().memberEmail is string && request.auth.token.email != null && incoming().memberEmail.lower() == request.auth.token.email.lower()) ||
        ('userEmail' in incoming() && incoming().userEmail is string && request.auth.token.email != null && incoming().userEmail.lower() == request.auth.token.email.lower()) ||
        ('userId' in incoming() && incoming().userId is string && incoming().userId == request.auth.uid) ||
        ('employeeId' in incoming() && incoming().employeeId is string && incoming().employeeId == request.auth.uid)
      );
      allow update, delete: if isSuperAdmin() || isLogOwner(resource.data);
    }

    match /daily_logs/{logId} {
      allow read: if isSuperAdmin() || isLogOwner(resource.data);
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        ('memberEmail' in incoming() && incoming().memberEmail is string && request.auth.token.email != null && incoming().memberEmail.lower() == request.auth.token.email.lower()) ||
        ('userEmail' in incoming() && incoming().userEmail is string && request.auth.token.email != null && incoming().userEmail.lower() == request.auth.token.email.lower()) ||
        ('userId' in incoming() && incoming().userId is string && incoming().userId == request.auth.uid) ||
        ('employeeId' in incoming() && incoming().employeeId is string && incoming().employeeId == request.auth.uid)
      );
      allow update, delete: if isSuperAdmin() || isLogOwner(resource.data);
    }
  }
}
